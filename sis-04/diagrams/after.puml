' diagrams/after.puml — the final code: data, rules, filter and UI apart. The UI imports the
' rules and holds no room data or rule of its own.
@startuml
title After (sis-04)
package "UI" {
  component "App.tsx" as App
  component "FilterPanel.tsx" as FilterPanel
  component "RoomList.tsx" as RoomList
  component "AvailabilityForm.tsx" as Form
  component "ResultPanel.tsx" as Result
  component "BookingList.tsx" as List
}
component "rooms.ts\nRoom, Equipment, ROOMS" as Rooms
component "filter.ts\nfilterRooms()" as Filter
component "booking.ts\ncanBook(), findRoom(),\ncheckRoom(), explainRoom()" as Booking
component "utils/time.ts" as Time

App --> FilterPanel
App --> RoomList
App --> Form
App --> Result
App --> List
App --> Rooms : ROOMS
App --> Filter : filterRooms()
App --> Booking : checkRoom(), explainRoom(), findRoom()
App --> Time
Filter --> Rooms : Room type
Booking --> Rooms : Room type
FilterPanel --> Rooms : EQUIPMENT
RoomList --> Rooms : Room type
List --> Rooms : Room type
List --> Time
Result --> Time
note right of Booking : checkRoom calls canBook with the\nchosen room's blocked and bookings
@enduml
